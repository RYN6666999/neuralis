# 已核准 keyword 覆寫（啟動時載入）
# ═══════════════════════════════════════════════════════════════

def _apply_domain_keyword_additions():
    from tulpa.tulpa_domain import _find_node
    db = _db()
    rows = db.execute("SELECT candidate, domain_path FROM domain_keyword_additions").fetchall()
    db.close()
    for r in rows:
        node = _find_node(r["domain_path"].split("/"))
        if node and r["candidate"] not in node.keywords: node.keywords.append(r["candidate"])
    db = _db()
    for r in db.execute("SELECT candidate, tulpa_name FROM tulpa_keyword_addition").fetchall():
        tgt = next((t for t in TULPAS if t.name == r["tulpa_name"]), None)
        if tgt and r["candidate"] not in tgt.keywords: tgt.keywords.append(r["candidate"])
    db.close()
