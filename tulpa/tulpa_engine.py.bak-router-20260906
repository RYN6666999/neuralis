_ERROR_TYPES = ("wrong_domain", "memory_confab", "logic_jump", "tulpa_win_wrong", "low_confidence")


def _log_mistake(input_pattern: str, error_type: str, domain_path: str,
                 tulpa_name: str, lesson: str) -> int:
    """寫入 mistake_catalog。重複模式 auto-increment triggered_count。"""
    now = datetime.utcnow().isoformat()
    db = _db()
    row = db.execute(
        "SELECT id FROM mistake_catalog WHERE input_pattern=? AND error_type=?",
        (input_pattern, error_type)
    ).fetchone()
    if row:
        db.execute(
            "UPDATE mistake_catalog SET triggered_count=triggered_count+1, last_triggered=? WHERE id=?",
            (now, row["id"])
        )
    else:
        db.execute(
            """INSERT INTO mistake_catalog
               (input_pattern, error_type, domain_path, tulpa_name, lesson, created_at)
               VALUES (?, ?, ?, ?, ?, ?)""",
            (input_pattern, error_type, domain_path, tulpa_name, lesson, now)
        )
    db.commit()
    result = db.execute("SELECT last_insert_rowid()").fetchone()[0]
    db.close()
    return result


def _assess_confidence(domain_str: str | None, winner_name: str,
                       domain_opt: dict, scored: list) -> dict:
    """評估這輪對話的 confidence，回傳 {score, signal, warning}。

    訊號來源（加權計算）：
    - domain_path 空 → -0.3
    - correction_rate > 0.3 → -0.2
    - winner = 本我理性 but text is contemplative → -0.15
    - low_score_gap (winner-second < 0.15) → -0.1
    """
    score = 1.0
    warnings = []
    signal = "high"

    # 1. domain_path 空
    if not domain_str:
        score -= 0.3
        warnings.append("未命中任何領域樹")

    # 2. 校正率偏高
    if domain_opt:
        rate = domain_opt.get("correction_rate", 0)
        if rate > 0.3:
            score -= 0.2
            warnings.append(f"校正率 {rate:.0%}")
        if rate > 0.5:
            score -= 0.1
            warnings.append(f"高校正率 {rate:.0%}")

    # 3. tulpa 勝出者不合適（本我理性勝出但 text 偏反思）
    if winner_name == "本我理性":
        score -= 0.1
        warnings.append("行動派 tulpa 勝出")

    # 4. 分數差距小 → 競爭不穩
    if len(scored) >= 2:
        sorted_scores = sorted([s for _, s in scored], reverse=True)
        gap = sorted_scores[0] - sorted_scores[1]
        if gap < 0.15:
            score -= 0.1
            warnings.append("分數差距過小")

    score = max(0.0, round(score, 2))
    if score < 0.5:
        signal = "critical"
    elif score < 0.75:
        signal = "low"

    return {"score": score, "signal": signal, "warnings": warnings}


def _generate_domain_suggestion(domain_str: str | None, winner_name: str, confidence: dict) -> dict | None:
    """每 50 輪掃描一次：產生領域樹生長提案。

    觸發條件：
    - wrong_domain 且 confidence signal 為 low/critical
    - 或每 50 輪定期掃描 domain_keyword_additions 表
    """
    db = _db()
    now = datetime.utcnow().isoformat()

    # 1. 掃描未歸類的 keyword candidates（已在 tulpa 但不在任何 domain）
    uncategorized = []
    try:
        uncategorized = db.execute("""
            SELECT candidate, tulpa_name, COUNT(*) as cnt
            FROM tulpa_keyword_additions
            WHERE tulpa_name = ?
            GROUP BY candidate
            HAVING cnt >= 3
        """, (winner_name,)).fetchall()
    except Exception:
        pass  # 表不存在或查詢失敗，跳過此步驟

    suggestions = []
    for row in uncategorized:
        candidate = row["candidate"]
        # 檢查是否已存在於任何 domain node
        from tulpa.tulpa_domain import _find_node, ALL_DOMAINS
        found = False
        for d in ALL_DOMAINS:
            def _has_kw(node, kw):
                if kw in node.keywords:
                    return True
                return any(_has_kw(c, kw) for c in node.children)
            if _has_kw(d, candidate):
                found = True
                break
        if not found:
            suggestions.append({
                "type": "add_keyword",
                "candidate": candidate,
                "tulpa": winner_name,
                "cnt": row["cnt"],
                "suggested_path": f"房產財商教練/未知/{candidate}",
            })

    # 2. 錯誤記憶中的高頻模式 → 建議新建領域
    if not domain_str:
        recent_errors = db.execute("""
            SELECT input_pattern, error_type, lesson, triggered_count
            FROM mistake_catalog
            WHERE error_type = 'wrong_domain'
              AND triggered_count >= 2
            ORDER BY triggered_count DESC
            LIMIT 3
        """).fetchall()
        for err in recent_errors:
            suggestions.append({
                "type": "new_domain",
                "pattern": err["input_pattern"],
                "lesson": err["lesson"],
                "confidence": confidence.get("score", 0.5),
            })

    db.close()
    return {"suggestions": suggestions, "generated_at": now} if suggestions else None


