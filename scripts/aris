#!/bin/zsh
# aris — 一屏看完 Aris 的狀態。減法可視化：沒有 dashboard、沒有 web、沒有依賴。
#
#   aris          狀態總覽
#   aris mem      看記憶檔全文（規則 + 近況）
#   aris log      看 digest 最近做了什麼
#   aris now      立刻跑一次 digest（不等 30 分鐘）
#
set -u
N=${NEURALIS_ROOT:-${0:A:h:h}}   # 預設 = 本腳本所在的 repo 根
MD=$N/ARIS.md
WM=$HOME/.gbrain/aris-digest.watermark
LOG=$N/aris-digest.log
DB=$HOME/.aris-memory.db

case "${1:-status}" in
mem)  cat "$MD" 2>/dev/null || echo "（還沒有記憶檔）"; exit 0 ;;
log)  tail -30 "$LOG" 2>/dev/null || echo "（還沒有 log）"; exit 0 ;;
now)  cd $N && ${PY3:-/opt/homebrew/bin/python3} scripts/aris-digest.py --incremental --apply; exit $? ;;
hist)
  # 全歷史：每次寫入前的快照，帶時間戳。要回到某一版就自己複製貼回 ARIS.md。
  if [ ! -f "$MD.history" ]; then echo "還沒有歷史"; exit 1; fi
  grep -n "^===== " "$MD.history" | tail -20
  echo
  echo "看某一版： sed -n '/^===== 2026-08-19 20:25/,/^===== /p' $MD.history"
  exit 0 ;;
undo)
  # 撤銷上一次 digest 寫入。只留一層——連按兩次是還原回去，不是往前兩步。
  if [ ! -f "$MD.undo" ]; then echo "沒有可撤銷的版本"; exit 1; fi
  cp "$MD" "$MD.redo" && cp "$MD.undo" "$MD" && mv "$MD.redo" "$MD.undo"
  echo "已撤銷。現在的記憶檔："; echo; cat "$MD"
  echo; echo "（再打一次 aris undo 會還原回去）"
  exit 0 ;;
esac

ok(){ curl -sf --max-time 2 "http://localhost:$1/health" >/dev/null 2>&1 && echo "✅" || echo "❌"; }

echo "───── Aris ─────"

# 心跳：Rust state 檔的 mtime 離現在幾秒
export ARIS_STATE=$N/../laap-AGI/aris_brain/state/rust-latest.json
beat=$(python3 - <<'EOF' 2>/dev/null
import os,time
p=os.environ["ARIS_STATE"]
try: print(f"{time.time()-os.stat(p).st_mtime:.0f}s 前")
except Exception: print("讀不到")
EOF
)
printf "心跳    %s  psi-daemon %s\n" "$beat" "$(pgrep -f psi-daemon >/dev/null && echo ✅ || echo ❌)"
# 2026-08-19：11546（laap chat API）已退役——流量 100% 是 curl 測試與
# watchdog 的 /health，Hermes 走 11547。watchdog 改守 11547。
printf "服務    11547 %s（認知·watchdog 守）  11551 %s（記憶）\n" "$(ok 11547)" "$(ok 11551)"
printf "守護    watchdog %s\n" "$(pgrep -f 'watchdog.sh 11547' >/dev/null && echo '✅ 盯 11547' || echo '❌ 沒在跑')"

# 情緒：讀 Rust 心跳直接寫的那份，不讀 11546 的轉手版 status.json。
# 2026-08-19 實測兩份不同步（status.json valence -1.0 vs 11547 -0.477）。
# 單一真相 = 源頭。順帶讓狀態列不依賴 11546 是否活著。
python3 - <<'EOF' 2>/dev/null
import json, time, os
P = os.environ["ARIS_STATE"]
try:
    d = json.load(open(P)); a = d.get("affect", {}); n = d.get("needs", {})
    age = time.time() - os.stat(P).st_mtime
    top = max(n, key=n.get) if n else "?"
    stale = "  ⚠️心跳停了" if age > 5 else ""
    print(f"情緒    pleasure {a.get('pleasure',0):+.2f}  arousal {a.get('arousal',0):.2f}"
          f"  需求 {top}{stale}")
except Exception as e:
    print(f"情緒    ❌ 讀不到 Rust 心跳檔（{type(e).__name__}）")
EOF

# 記憶
# 三區計數一律問 aris-digest.py --stats（唯一實作）。
# 2026-08-19：這裡原本手抄一份切法。兩份實作必然漂移——標頭字串改了只改到
# 一邊，狀態列就靜默顯示錯的數字。刪掉手抄，判準只留一個地方。
${PY3:-/opt/homebrew/bin/python3} "$N/scripts/aris-digest.py" --stats 2>/dev/null \
| ${PY3:-/opt/homebrew/bin/python3} -c '
import sys, json
raw = sys.stdin.read().strip()
if not raw:
    print("記憶    ❌ 拿不到統計（aris-digest.py --stats 沒輸出）"); raise SystemExit
d = json.loads(raw)
bar = min(int(d["size"] / d["cap"] * 20), 20)
over = " ⚠️超標" if d["size"] > d["cap"] else ""
print("記憶    {}/{} [{}{}]{}  規則 {} · 地標 {} · 近況 {}".format(
    d["size"], d["cap"], "█" * bar, "·" * (20 - bar), over,
    d["rules"], d["marks"], d["recent"]))
'

# digest
if [ -f "$WM" ]; then
  wm=$(cat "$WM")
  new=$(sqlite3 "$DB" "select count(*) from memories where source in ('hermes-cli','webchat') and id > $wm;" 2>/dev/null)
  last=$(python3 -c "
import os,time
try: print(f'{(time.time()-os.stat(\"$LOG\").st_mtime)/60:.0f} 分鐘前')
except Exception: print('沒跑過')" 2>/dev/null)
  loaded=$(launchctl list 2>/dev/null | grep -c aris-digest)
  printf "消化    上次 %s  待處理 %s 筆  排程 %s\n" "$last" "${new:-?}" \
    "$([ "$loaded" -gt 0 ] && echo '✅ 每30分' || echo '❌ 未掛')"
else
  echo "消化    水位檔不存在"
fi

echo "────────────────"
echo "aris mem | aris log | aris now | aris undo | aris hist"
