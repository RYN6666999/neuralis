def _init_keyword_stats():
    db = _db()
    for t in TULPAS:
        for kw in t.keywords:
            db.execute("INSERT INTO keyword_stats (keyword, tulpa_name, lifetime_misses, active) VALUES (?, ?, 0, 1) ON CONFLICT(keyword, tulpa_name) DO NOTHING", (kw, t.name))
    db.commit(); db.close()


def _log_migration(tulpa_name: str):
    t = next((x for x in TULPAS if x.name == tulpa_name), None)
    if t is None: return
    defaults = {"本我理性": (0.7, 0.6), "本我感性": (0.5, 0.5), "自我理性": (0.3, 0.8),
                "自我感性": (0.3, 0.6), "超我理性": (0.3, 0.7), "超我感性": (0.4, 0.7)}
    du, di = defaults.get(tulpa_name, (0.5, 0.5))
    now = datetime.utcnow().isoformat()
    db = _db()
    for param, default_val, current_val in [("base_urgency", du, t.base_urgency), ("base_importance", di, t.base_importance), ("base_weight", 1.0, t.base_weight)]:
        delta = round(current_val - default_val, 4)
        if abs(delta) < 0.001: continue
        db.execute("INSERT INTO migration_log (session_id, turn, tulpa_name, param, default_val, current_val, delta, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
                   (_session_id, _turn_counter, tulpa_name, param, default_val, current_val, delta, now))
    db.commit(); db.close()


def _track_keyword_miss(text: str):
    """只追蹤本輪有命中的 tulpa 中未觸發的關鍵字（取代每輪對所有 keyword 跑一次）。"""
    now = datetime.utcnow().isoformat()
    db = _db()
    updates = []
    for t in TULPAS:
        if not any(kw in text for kw in t.keywords):
            continue  # 這個 tulpa 完全沒命中 → 不追蹤 misses（太多雜訊）
        for kw in t.keywords:
            if kw not in text:
                updates.append((now, kw, t.name))
    if updates:
        db.executemany("UPDATE keyword_stats SET lifetime_misses=lifetime_misses+1, last_miss=? WHERE keyword=? AND tulpa_name=?", updates)
        db.commit()
    db.close()


def _track_domain_candidates(text: str, domain_path: list):
    if not domain_path: return
    path = "/".join(domain_path)
    known = _path_keywords(domain_path)
    path_names = set(domain_path)
    now = datetime.utcnow().isoformat()
    db = _db()
    import jieba, re as _re
    for w in ["斡旋","跟催","下斡","帶看","成交","簽約","出價","追款","售後","過戶","交屋","陌生拜訪","既有客戶"]:
        jieba.add_word(w)
    tokens = [w.strip() for w in jieba.cut(text) if w.strip()]
    tokens += _re.findall(r'[a-zA-Z]{2,12}', text)
    for tok in tokens:
        if tok in known or tok in path_names or len(tok) < 2 or tok.isdigit(): continue
        db.execute("INSERT INTO domain_keyword_candidates (candidate, domain_path, count, first_seen, last_seen, state) VALUES (?, ?, 1, ?, ?, 'observing') ON CONFLICT(candidate, domain_path) DO UPDATE SET count=count+1, last_seen=excluded.last_seen",
                   (tok, path, now, now))
    db.commit()
    for cand in db.execute("SELECT candidate, domain_path, count FROM domain_keyword_candidates WHERE state='observing' AND count >= ? AND domain_path=?", (4, path)).fetchall():
        conf = min(0.9, 0.4 + 0.1 * cand["count"])
        db.execute("INSERT INTO pending_suggestions (session_id, insight_type, suggested_action, description, confidence, evidence, status, created_at) VALUES (?, 'domain_keyword', 'add_keyword', ?, ?, ?, 'pending', ?)",
                   (_session_id, f"新增領域關鍵字「{cand['candidate']}」到 {cand['domain_path']}（已出現 {cand['count']} 次）", round(conf, 2), json.dumps({"candidate": cand["candidate"], "domain_path": cand["domain_path"], "count": cand["count"]}), now))
        db.execute("UPDATE domain_keyword_candidates SET state='proposed' WHERE candidate=? AND domain_path=?", (cand["candidate"], cand["domain_path"]))
    for cr in db.execute("SELECT candidate, COUNT(DISTINCT domain_path) AS npaths, SUM(count) AS total FROM domain_keyword_candidates WHERE state='observing' GROUP BY candidate HAVING npaths >= 2 AND total >= ?", (4,)).fetchall():
        conf = min(0.9, 0.4 + 0.1 * cr["total"])
        db.execute("INSERT INTO pending_suggestions (session_id, insight_type, suggested_action, description, confidence, evidence, status, created_at) VALUES (?, 'domain_crosslink', 'crosslink', ?, ?, ?, 'pending', ?)",
                   (_session_id, f"跨領域連結：詞「{cr['candidate']}」在 {cr['npaths']} 條路徑出現 {cr['total']} 次", round(conf, 2), json.dumps({"candidate": cr["candidate"], "npaths": cr["npaths"], "total": cr["total"]}), now))
        db.execute("UPDATE domain_keyword_candidates SET state='proposed' WHERE candidate=? AND state='observing'", (cr["candidate"],))
    db.commit(); db.close()


def _track_domain_hit(domain_path: list):
