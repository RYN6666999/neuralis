def _record_claim(claim: str) -> int:
    """宣稱一件事完成了。回 verification_log 第一輪 id。"""
    db = _db()
    now = datetime.utcnow().isoformat()
    db.execute("INSERT INTO verification_log (claim, round, found, method, verdict, created_at) VALUES (?, 1, 0, 'initial_claim', 'pending', ?)",
               (claim, now))
    db.commit()
    row_id = db.execute("SELECT last_insert_rowid()").fetchone()[0]
    db.close()
    return row_id


def _verify_claim(claim_id: int, found: int, method: str = "red_team") -> dict:
    """驗證一筆 claim：找到新 bug → 紀錄 → 回累計。found=0 時 verdict 改 confirmed。"""
    db = _db()
    row = db.execute("SELECT claim, round, found FROM verification_log WHERE id=?", (claim_id,)).fetchone()
    if not row:
        db.close()
        return {"error": "claim not found"}
    
    prev_total = row["found"]
    new_total = prev_total + found
    next_round = row["round"] + 1
    now = datetime.utcnow().isoformat()
    
    if found == 0:
        verdict = "confirmed"
    else:
        verdict = "busted"
    
    db.execute("INSERT INTO verification_log (claim, round, found, method, verdict, created_at) VALUES (?, ?, ?, ?, ?, ?)",
               (row["claim"], next_round, found, method, verdict, now))
    db.commit()
    db.close()
    return {
        "claim": row["claim"],
        "round": next_round,
        "found_this_round": found,
        "total_found": new_total,
        "verdict": verdict,
        "took_rounds": next_round,
    }


def _completion_stats() -> dict:
    """分析所有 claim 的歷史資料：我總是宣稱太早。"""
    db = _db()
    rows = db.execute("""
        SELECT claim, MAX(round) as rounds, SUM(found) as total_found,
               MIN(CASE WHEN verdict='confirmed' THEN round ELSE 999 END) as confirmed_at
        FROM verification_log 
        GROUP BY claim
        ORDER BY created_at DESC LIMIT 20
    """).fetchall()
    db.close()
    stats = []
    for r in rows:
        confirmed = r["confirmed_at"] if r["confirmed_at"] < 999 else None
        stats.append({
            "claim": r["claim"],
            "rounds": r["rounds"],
            "total_found": r["total_found"],
            "confirmed_at_round": confirmed,
        })
    # 平均：第幾輪才真正確認完成
    confirmed_rounds = [s["confirmed_at_round"] for s in stats if s["confirmed_at_round"]]
    avg_rounds = sum(confirmed_rounds) / len(confirmed_rounds) if confirmed_rounds else 0
    return {
        "total_claims": len(rows),
        "confirmed": len(confirmed_rounds),
        "avg_rounds_to_done": round(avg_rounds, 1),
        "stats": stats,
    }


