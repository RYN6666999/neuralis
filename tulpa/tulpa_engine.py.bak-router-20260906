def _log_psi_action(trigger_type: str, psi_before: float, action: str, turn: int):
    """記錄 PSI 觸發的行動。action_taken/outcome 初始為 0，由後續 call 更新。"""
    db = _db()
    now = datetime.utcnow().isoformat()
    db.execute("INSERT INTO psi_action_log (trigger_type, psi_before, action, action_taken, outcome, turn, created_at) VALUES (?, ?, ?, 0, 0, ?, ?)",
               (trigger_type, psi_before, action, turn, now))
    db.commit()
    db.close()


def _record_psi_action_outcome(trigger_type: str, action: str, action_taken: bool, outcome: bool, psi_after: float | None = None):
    """更新最近一筆 PSI 行動的執行狀態與有效性。
    
    有效性指標定義：
    ask_clear  → action_taken=1 表示我確實問了問題而不是直接回答
                outcome=1 表示用戶回覆後我的 certainty 提升了
    verify_first → action_taken=1 表示我確實跑了工具驗證
                outcome=1 表示驗證結果改變了我原本的結論
    self_audit → action_taken=1 表示我確實查了 DB
                outcome=1 表示找到新問題或確認無問題
    """
    db = _db()
    row = db.execute(
        "SELECT id FROM psi_action_log WHERE trigger_type=? AND action=? AND action_taken=0 AND outcome=0 ORDER BY id DESC LIMIT 1",
        (trigger_type, action)
    ).fetchone()
    if not row:
        db.close()
        return
    db.execute("UPDATE psi_action_log SET action_taken=?, outcome=?, psi_after=? WHERE id=?",
               (1 if action_taken else 0, 1 if outcome else 0, psi_after, row["id"]))
    db.commit()
    db.close()


def _psi_action_effectiveness() -> list[dict]:
    """查詢 PSI 行為觸發的有效性統計。"""
    db = _db()
    rows = db.execute("""
        SELECT trigger_type, action,
               COUNT(*) as total,
               SUM(action_taken) as taken,
               SUM(outcome) as effective
        FROM psi_action_log
        GROUP BY trigger_type, action
    """).fetchall()
    db.close()
    return [
        {
            "trigger": r["trigger_type"],
            "action": r["action"],
            "total": r["total"],
            "taken": r["taken"] or 0,
            "effective": r["effective"] or 0,
            "taken_rate": round((r["taken"] or 0) / max(r["total"], 1), 2),
            "effective_rate": round((r["effective"] or 0) / max(r["total"], 1), 2),
        }
        for r in rows
    ]

# ═══════════════════════════════════════════════════════════════
# 自審（self-audit）：每輪 compete 結束後自動檢查
# ═══════════════════════════════════════════════════════════════

def _self_audit(domain_str: str | None, winner_name: str):
    """compete 結束後自動審計：掃描高校正率、記錄 sui

    寫入 observer_insights，讓 hook 下一輪讀得到。
    """
    if not domain_str:
        return
    db = _db()
    row = db.execute(
        "SELECT corrections, total_hits, effective_hits FROM domain_optimization WHERE path=?",
        (domain_str,)
    ).fetchone()
    if not row or row["total_hits"] < 2:
        db.close()
        return  # 數據不足，不亂報
    rate = row["corrections"] / max(row["total_hits"], 1)
    if rate < 0.4:
        db.close()
        return  # 🟢 範圍，不需提醒
    insight_type = "domain_correction_high" if rate > 0.6 else "domain_correction_warn"
    desc = f"[自我審計] {domain_str}: 校正率 {row['corrections']}/{row['total_hits']} = {rate:.0%}"
    now = datetime.utcnow().isoformat()
    db.execute("""INSERT INTO observer_insights (turn, insight_type, description, evidence, confidence, addressed, created_at)
                  VALUES (?, ?, ?, ?, ?, 0, ?)""",
               (_turn_counter, insight_type, desc,
                json.dumps({"domain": domain_str, "corrections": row["corrections"],
                            "total": row["total_hits"], "rate": round(rate, 2),
                            "winner": winner_name}),
                0.8 if rate > 0.6 else 0.5, now))
    db.commit()
    db.close()


# ═══════════════════════════════════════════════════════════════
# Observer 第三位置（meta-tulpa）— 觀察競爭過程
# ═══════════════════════════════════════════════════════════════

def _observe_third_position(winner, losers, domain_str):
    """meta-tulpa 觀察競爭 → 寫入 observer_insights
    
    檢測：
    1. Conflict：贏家和第二名分數差 < 0.1
    2. Contradiction：贏家 weight 卻比上輪低
    """
    db = _db()
    now = datetime.utcnow().isoformat()
    
    # 計算分數差距
    if losers and len(losers) > 0:
        second = losers[0]
        gap = winner.score - second.score
        if gap < 0.1:
            db.execute("""INSERT INTO observer_insights 
                         (turn, insight_type, description, evidence, confidence, addressed, created_at)
                         VALUES (?, 'conflict_detected', ?, ?, 0.7, 0, ?)""",
                      (_turn_counter,
                       f"領域 {domain_str}: 贏家與第二名分數差僅 {gap:.3f}",
                       json.dumps({"winner": winner.name, "second": second.name, "gap": round(gap, 3)}),
                       now))
    
    # 檢查 weight 趨勢
    prev_weight = db.execute(
        "SELECT current_val FROM migration_log WHERE tulpa_name=? ORDER BY id DESC LIMIT 1",
        (winner.name,)
    ).fetchone()
    if prev_weight and winner.base_weight < prev_weight[0]:
        db.execute("""INSERT INTO observer_insights 
                     (turn, insight_type, description, evidence, confidence, addressed, created_at)
                     VALUES (?, 'weight_regression', ?, ?, 0.6, 0, ?)""",
                  (_turn_counter,
                   f"贏家 {winner.name} weight 下降: {prev_weight[0]:.3f} → {winner.base_weight:.3f}",
                   json.dumps({"tulpa": winner.name, "prev": prev_weight[0], "current": winner.base_weight}),
                   now))

    db.commit()
    db.close()

    # 3. wrong_domain：未命中任何領域但輸入有明確專業語氣
    if not domain_str and losers and len(losers) > 0:
        for t, s in [(winner, winner.score)] + [(r['name'], r['score']) for r in losers]:
            if s > 0.7:
                desc = f"錯域警報：輸入未命中領域樹，但 {t} 打出 {s:.2f} 分（可能領域樹覆蓋不足）"
                db = _db()
                db.execute("""INSERT INTO observer_insights
                             (turn, insight_type, description, evidence, confidence, addressed, created_at)
                             VALUES (?, 'wrong_domain_alert', ?, ?, 0.5, 0, ?)""",
                          (_turn_counter, desc, json.dumps({"tulpa": t, "score": round(s, 2)}), now))
                db.commit()
                db.close()
                break

    # 4. 重複錯誤聚合：同一 error_type 出現 >= 2 次 → 觸發鋼人審計提案
    try:
        db2 = _db()
        repeat_rows = db2.execute(
            """SELECT error_type, COUNT(*) as cnt
               FROM mistake_catalog
               WHERE last_triggered > datetime('now', '-7 days')
               GROUP BY error_type HAVING cnt >= 2"""
        ).fetchall()
        for row in repeat_rows:
            desc = f"錯誤重複：'{row['error_type']}' 在本週已觸發 {row['cnt']} 次，建議啟動鋼人審計重新評估該領域"
            db2.execute("""INSERT INTO observer_insights
                         (turn, insight_type, description, evidence, confidence, addressed, created_at)
                         VALUES (?, 'repeat_error', ?, ?, 0.8, 0, ?)""",
                       (_turn_counter, desc, json.dumps({"error_type": row["error_type"], "count": row["cnt"]}), now))
        db2.commit()
        db2.close()
    except Exception:
        pass


