def apply_gene_adjustments() -> dict:
    """讀 genes/*.json，對匹配的 tulpa 施加 weight penalty，寫回 DB 及記憶體。
    幂等：每次呼叫都以 DB 中的 current base_weight 為基準。
    同時更新 TULPAS 列表中的記憶體狀態，確保後續 save_tulpa_state 能持久化。
    """
    if not _GENE_DIR.exists():
        return {}
    adjustments = {}
    db = _db()
    for gene_file in _GENE_DIR.glob("*.json"):
        try:
            gene = json.loads(gene_file.read_text())
        except Exception:
            continue
        tool = gene.get("tool", "")
        penalty = _TOOL_PENALTY.get(tool)
        if penalty is None:
            continue
        targets = _TOOL_TULPA_TARGET.get(tool, [])
        if not targets:
            continue
        for tname in targets:
            row = db.execute(
                "SELECT base_weight FROM tulpa_state WHERE name=?", (tname,)
            ).fetchone()
            if row is None:
                continue
            old_w = row["base_weight"]
            new_w = max(0.1, old_w * penalty)
            db.execute(
                "UPDATE tulpa_state SET base_weight=? WHERE name=?", (new_w, tname)
            )
            # 同步更新記憶體中的 TULPAS 對象
            for t in TULPAS:
                if t.name == tname:
                    t.base_weight = new_w
                    break
            adjustments[f"{tname}/{tool}"] = {"old": round(old_w, 4), "new": round(new_w, 4)}
    # ── 結果獎懲：mistake_outcome(label) → 對應 tulpa 權重 ──
    # 把「你有結果的判定」接成獎懲訊號：avoided(有用)→獎勵，recurred(無用)→懲罰。
    # T3 (LUCID 去膨脹)：只對 source='human'（真人/外部）的 label 施加權重。
    #     AI 自標(source='self')/工具(source='tool') 的 label 不進權重——讓 reward 誤差與 AI 盲點去相關。
    # 修正(2026-09-06 排雷抓到)：原本非冪等——每次 compete 對同 label 重複計入、權重複利無限成長。
    #    現以 consumed 旗標：每筆 human label 只計入一次後設 consumed=1，跨 call 也不複利。
    skipped_self = 0
    try:
        # 只處理尚未計入的 human label（consumed=0）
        rows = db.execute(
            "SELECT mo.id, mc.tulpa_name, mo.outcome "
            "FROM mistake_outcome mo JOIN mistake_catalog mc ON mc.id=mo.mistake_id "
            "WHERE mc.tulpa_name != '' AND mo.outcome IN ('avoided','recurred') "
            "AND mo.source = 'human' AND mo.consumed = 0"
        ).fetchall()
        for r in rows:
            ev_id, tname, outcome = r["id"], r["tulpa_name"], r["outcome"]
            prow = db.execute(
                "SELECT base_weight FROM tulpa_state WHERE name=?", (tname,)
            ).fetchone()
            if prow is None:
                continue
            old_w = prow["base_weight"]
            factor = 1.05 if outcome == "avoided" else 0.92
            new_w = round(max(0.1, min(1.5, old_w * factor)), 4)
            db.execute(
                "UPDATE tulpa_state SET base_weight=? WHERE name=?", (new_w, tname)
            )
            # 這筆 label 已計入，標 consumed，避免下次重複
            db.execute(
                "UPDATE mistake_outcome SET consumed=1 WHERE id=?", (ev_id,)
            )
            for t in TULPAS:
                if t.name == tname:
                    t.base_weight = new_w
                    break
            adjustments[f"{tname}/outcome::{outcome}"] = {"old": round(old_w, 4), "new": new_w}
    except Exception:
        pass
    # T3: 統計被略過的 AI 自標/工具 label 數（證明去膨脹真的生效，非空殼）
    try:
        skipped_self = db.execute(
            "SELECT count(*) FROM mistake_outcome mo "
            "JOIN mistake_catalog mc ON mc.id=mo.mistake_id "
            "WHERE mc.tulpa_name != '' AND mo.outcome IN ('avoided','recurred') "
            "AND mo.source IN ('self','tool')"
        ).fetchone()[0]
    except Exception:
        skipped_self = 0
    adjustments["_skipped_nonhuman_labels"] = skipped_self
    db.commit()
    db.close()
    return adjustments


