def _get_orientation(path: str) -> list[str]:
    """合併靜態 + 學習過的定向。學習 confidence 夠高時覆蓋靜態。
    
    規則：
    - 無學習數據 → 回靜態字典
    - 學習 score >= 0.6 且 samples >= 3 → 學習定向優先
    - 學習 score < 0.6 → 靜態 + 學習混合（學習的在前面）
    """
    static = DOMAIN_ORIENTATION.get(path, [])
    db = _db()
    rows = db.execute(
        "SELECT tulpa_name, score, wins FROM domain_learned_orientation "
        "WHERE path=? ORDER BY score DESC",
        (path,)
    ).fetchall()
    db.close()

    if not rows:
        return static  # 沒有學習數據，純靜態

    learned = [r["tulpa_name"] for r in rows]
    top_score = rows[0]["score"]
    top_wins = rows[0]["wins"]

    if top_score >= 0.6 and top_wins >= 3:
        # 學習 confidence 夠高 → 學習定向為主，靜態為補
        result = learned[:]
        for t in static:
            if t not in result:
                result.append(t)
        return result

    # 低 confidence → 靜態在前，學習在後（還在學階段）
    seen = set(static)
    result = list(static)
    for t in learned:
        if t not in seen:
            result.append(t)
    return result


def _update_learned_orientation(path: str, winner_name: str, expected: list[str]):
    """校正發生時：winners 加分，expected 中輸家減分。"""
    db = _db()
    row = db.execute(
        "SELECT score, wins FROM domain_learned_orientation WHERE path=? AND tulpa_name=?",
        (path, winner_name)
    ).fetchone()
    if row:
        new_score = min(1.0, row["score"] + 0.12)
        new_wins = row["wins"] + 1
        db.execute(
            "UPDATE domain_learned_orientation SET score=?, wins=? WHERE path=? AND tulpa_name=?",
            (new_score, new_wins, path, winner_name)
        )
    else:
        db.execute(
            "INSERT INTO domain_learned_orientation (path, tulpa_name, score, wins) VALUES (?, ?, 0.5, 1)",
            (path, winner_name)
        )

    # Expected 中輸家減分
    for t_name in expected:
        if t_name == winner_name:
            continue
        row2 = db.execute(
            "SELECT score FROM domain_learned_orientation WHERE path=? AND tulpa_name=?",
            (path, t_name)
        ).fetchone()
        if row2:
            new_score = max(0.10, row2["score"] - 0.06)
            db.execute(
                "UPDATE domain_learned_orientation SET score=? WHERE path=? AND tulpa_name=?",
                (new_score, path, t_name)
            )
    db.commit()
    db.close()


def _reinforce_orientation(path: str, winner_name: str, expected: list[str]):
    """Winner 符合預期時微加分（每 3 次才記一次，避免膨脹）。"""
    if not expected or winner_name not in expected:
        return
    db = _db()
    row = db.execute(
        "SELECT score, wins FROM domain_learned_orientation WHERE path=? AND tulpa_name=?",
        (path, winner_name)
    ).fetchone()
    if row:
        # 只有 wins % 3 == 0 時才強化，避免每輪都加
        if (row["wins"] + 1) % 3 == 0:
            new_score = min(1.0, row["score"] + 0.02)
            new_wins = row["wins"] + 1
            db.execute(
                "UPDATE domain_learned_orientation SET score=?, wins=? WHERE path=? AND tulpa_name=?",
                (new_score, new_wins, path, winner_name)
            )
    else:
        # 新 tulpa 在 expected 中但從未記錄過 → 起始 0.4（存在但不確定）
        db.execute(
            "INSERT INTO domain_learned_orientation (path, tulpa_name, score, wins) VALUES (?, ?, 0.4, 1)",
            (path, winner_name)
        )
    db.commit()
    db.close()


def _track_domain_perf(path: str | None, winner_name: str, session_id: str, turn: int):
    """記錄領域節點命中 + 跨輪校正偵測 + 從校正中學習定向"""
    if not path:
        return
    if not session_id:
        # 沒有session_id時自動生成一個（防止數據遺失）
        session_id = f"anon-{int(time.time())}"
    db = _db()
    # 更新 domain_optimization
    db.execute("""
        INSERT INTO domain_optimization (path, total_hits, last_turn, effective_hits)
        VALUES (?, 1, ?, 1)
        ON CONFLICT(path) DO UPDATE SET
            total_hits=total_hits+1,
            last_turn=excluded.last_turn,
            effective_hits=effective_hits+1
    """, (path, turn))
    db.commit()
    db.close()

    # 校正偵測 + 學習：使用學習過的定向（靜態 + 學習混合）
    expected = _get_orientation(path)
    prev_path = _last_domain_path.get(session_id)
    if prev_path and prev_path != path:
        # 換領域了 → 不是校正
        pass
    elif prev_path == path:
        # 同一領域但不同輪 — 檢查 winner 是否違反定向
        if expected and winner_name not in expected:
            # 校正！記錄 + 學習
            db2 = _db()
            db2.execute("""
                UPDATE domain_optimization SET
                    corrections=corrections+1,
                    effective_hits=MAX(0, effective_hits-1)
                WHERE path=?
            """, (path,))
            db2.commit()
            db2.close()
            # 從這次校正中學習：winner 加分，expected 輸家減分
            _update_learned_orientation(path, winner_name, expected)
        else:
            # Winner 符合預期 → 強化定向
            _reinforce_orientation(path, winner_name, expected)

    # 更新 session track
    _last_domain_path[session_id] = path


