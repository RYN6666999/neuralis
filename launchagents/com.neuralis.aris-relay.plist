<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.neuralis.aris-relay</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>source ~/.zshrc 2>/dev/null; cd /Users/ryan/Developer/neuralis &amp;&amp; PORT=11550 ARIS_API=http://localhost:11546/v1/chat/completions exec /opt/homebrew/bin/python3 scripts/aris-relay.py</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/tmp/com.neuralis.aris-relay.log</string>
  <key>StandardErrorPath</key><string>/tmp/com.neuralis.aris-relay.log</string>
</dict>
</plist>
