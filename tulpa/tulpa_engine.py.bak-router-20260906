def _path_similarity(path_a: str, path_b: str) -> float:
    if not path_a or not path_b: return 0.0
    a, b = path_a.split("/"), path_b.split("/")
    if a == b: return 1.0
    score = 0.0
    if len(a) == len(b): score += 0.3
    if a[0] == b[0]: score += 0.3
    if len(a) > 1 and len(b) > 1 and a[1] == b[1]: score += 0.2
    if len(a) > 2 and len(b) > 2 and a[2] == b[2]: score += 0.2
    return min(1.0, score)


