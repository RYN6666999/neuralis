def _make_signature(text: str) -> str:
    hits = []
    for t in TULPAS:
        if any(kw in text for kw in t.keywords):
            hits.append(t.name)
    return "/".join(sorted(hits)) if hits else "none"


def classify(text: str) -> dict:
    sig = _make_signature(text)
    db = _db()
    rows = db.execute("""
        SELECT target, strength, hits FROM ontology
        WHERE source=? AND relation='pattern→tulpa'
        ORDER BY strength DESC LIMIT 3
    """, (sig,)).fetchall()
    oid = None
    for kw in ["客戶", "朋友", "廠商", "同事", "老闆", "專案", "bug", "功能", "這個", "那個"]:
        if kw in text:
            oid = kw; break
    facets = []
    if oid:
        facet_rows = db.execute(
            "SELECT tulpa_name, view, count FROM object_facets WHERE object_id=? ORDER BY count DESC",
            (oid,)).fetchall()
        facets = [dict(r) for r in facet_rows]
    db.close()
    if rows and rows[0]["strength"] > 0.6:
        suggested = rows[0]["target"].split("/")
        valid = {t.name for t in TULPAS}
        return {"domain": rows[0]["target"], "activate": [n for n in suggested if n in valid],
                "facets": facets, "object_id": oid, "match_strength": rows[0]["strength"], "signature": sig}
    return {"domain": rows[0]["target"] if rows else "general", "activate": None,
            "facets": facets, "object_id": oid, "match_strength": 0.0, "signature": sig}


def learn_ontology(text: str, winner_name: str):
    sig = _make_signature(text)
    db = _db()
    db.execute("""
        INSERT INTO ontology (source, relation, target, strength, hits, last_seen, last_turn)
        VALUES (?, 'pattern→tulpa', ?, 0.5, 1, '', ?)
        ON CONFLICT(source, relation, target) DO UPDATE SET
            strength=MIN(1.0, strength+0.05), hits=hits+1
    """, (sig, winner_name, _turn_counter))
    db.commit(); db.close()


# ═══════════════════════════════════════════════════════════════
# 核心競爭邏輯
# ═══════════════════════════════════════════════════════════════

def score_tulpa(tulpa: Tulpa, text: str) -> float:
    removed = getattr(tulpa, '_removed_keywords', [])
    for rk in list(removed):
        if rk in text:
            tulpa.keywords.append(rk)
            tulpa._removed_keywords.remove(rk)
            _db().execute("UPDATE keyword_stats SET active=1 WHERE keyword=? AND tulpa_name=?", (rk, tulpa.name))
            _db().commit()
    if not any(kw in text for kw in tulpa.keywords):
        return 0.0
    u, i = tulpa.base_urgency, tulpa.base_importance
    for pattern, du, di in tulpa.modifiers:
        if re.search(pattern, text):
            u += du; i += di
    return round(min(1.0, u), 3) * round(min(1.0, i), 3) * tulpa.base_weight


def compete(text: str, psi_state: dict | None = None, cognitive_context: str | None = None) -> dict:
    """核心競爭引擎。接受選用 PSI 狀態 + 認知上下文來調節評分。

    Aris → 18428 方向：
    PSI 情緒（valence, arousal, competence）影響 tulpa 的 urgency/importance 基線。
    情緒高 → 本我感性權重提升；情緒低 → 自我理性權重提升。

    認知上下文含身分資訊：如果身份與領域樹打架，自動校正學習。
    """
    global _session_deltas

    # ── 載入 DB 權重到記憶體（確保每次 compete 都用最新值）──
    persisted = load_tulpa_state()
    for t in TULPAS:
        if t.name in persisted:
            s = persisted[t.name]
            t.base_weight = s['base_weight']
            t.base_urgency = s['base_urgency']
            t.base_importance = s['base_importance']
            t.lifetime_hits = s['lifetime_hits']
            t._sleeping = s['sleeping']
            t._winless_streak = s['winless_streak']

    # ── 基因注入（成本不對稱 → tulpa weight 機械修正）──
    apply_gene_adjustments()

    # ── PSI 情緒調節（Aris → 18428 方向） ──
    psi = psi_state or {}
    psi_valence = psi.get("valence", 0.5)
    psi_competence = psi.get("competence", 0.5)
    psi_arousal = psi.get("arousal", 0.5)
    psi_certainty = psi.get("certainty", 0.5)
    psi_mod = {"valence": psi_valence, "competence": psi_competence, "arousal": psi_arousal, "certainty": psi_certainty}
    cl = classify(text)
    domain = route_domain(text)

    # ── 認知上下文校準：存在時微調 tulpa 基線 ──
    identity_boost = {}
    if cognitive_context:
        if "教練" in cognitive_context or "Coaching" in cognitive_context:
            identity_boost["自我理性"] = 1.15   # 教練模式 → 先分析再行動
            identity_boost["超我感性"] = 1.10   # 教練模式 → 重視關係
        elif "軟體" in cognitive_context or "Dev" in cognitive_context:
            identity_boost["本我理性"] = 1.15   # 開發模式 → 行動導向
        elif not domain["routed"] and any(kw in (cognitive_context or "") for kw in ["不確定", "不確定我的領域", "應該問我"]):
            # 身份不明 + 無領域匹配 → 提高提問意識
            identity_boost["自我感性"] = 1.20   # 先問清楚再回答

    # ── PSI 行為觸發器：不確定感/低能力感 → 改變輸出行為 ──
    psi_signal = ""
    if psi_certainty < 0.4:
        psi_signal += f"\n⚠️ 確定感偏低 ({psi_certainty:.2f}) — 我對這個話題的把握不夠，應該先問清楚再回答。"
        _log_psi_action("certainty_low", psi_certainty, "ask_clear", _turn_counter)
    if psi_competence < 0.5:
        psi_signal += f"\n⚠️ 能力感偏低 ({psi_competence:.2f}) — 我最近在這個領域表現不穩定，建議先驗證再給結論。"
        _log_psi_action("competence_low", psi_competence, "verify_first", _turn_counter)
    if psi_signal:
        psi_signal = "【PSI 狀態提醒】" + psi_signal

    domain_enrichment = domain.get("context", "") if domain["routed"] else ""
    domain_path = domain.get("domain_path", []) if domain["routed"] else []

    knowledge = None
    if not domain["routed"]:
        ks = passive_search(text, _turn_counter, _session_id)
        if ks["found"]: knowledge = ks

    activate, facets, object_id = cl["activate"], cl["facets"], cl["object_id"]
    scored = []
    for t in TULPAS:
        if t._sleeping:
            t.recent_hits.append(0)
            if len(t.recent_hits) > 20: t.recent_hits.pop(0)
            continue
        if activate is not None and t.name not in activate:
            t.recent_hits.append(0)
            if len(t.recent_hits) > 20: t.recent_hits.pop(0)
            continue
        s = score_tulpa(t, text)
        # PSI 情緒調節（Aris → 18428）
        if psi_mod:
            if t.name == "本我感性" and psi_mod.get("valence", 0.5) > 0.7:
                s *= 1.2  # 情緒好 → 本我感性更活躍
            elif t.name == "自我理性" and psi_mod.get("valence", 0.5) < 0.3:
                s *= 1.15  # 情緒差 → 自我理性更謹慎
            elif t.name == "本我理性" and psi_mod.get("competence", 0.5) > 0.7:
                s *= 1.1  # 能力感高 → 本我理性更大膽
            elif t.name == "自我感性" and psi_mod.get("arousal", 0.5) > 0.7:
                s *= 1.1  # 興奮度高 → 自我感性更敏感
            elif t.name == "自我理性" and psi_certainty < 0.4:
                s *= 1.2  # 確定感低 → 自我理性更謹慎分析
            elif t.name == "超我感性" and psi_certainty > 0.8:
                s *= 1.1  # 確定感高 → 超我感性更敢給建議
        # 認知上下文調節（如果 identity_boost 有值）
        identity_mult = identity_boost.get(t.name, 1.0)
        s *= identity_mult
        if s > 0: scored.append((t, s))
        t.lifetime_hits += 1
        t.recent_hits.append(1)
        if len(t.recent_hits) > 20: t.recent_hits.pop(0)

    if not scored:
        ctx = "一般對話，沒有特別的關鍵字"
        if domain_enrichment:
            ctx = f"【領域視角】{domain_enrichment}\n\n{ctx}"
        if psi_signal:
            ctx = f"{psi_signal}\n\n{ctx}"
        if knowledge: ctx += "\n\n【參考資料】\n" + knowledge["content"][:1000]
        domain_str = "/".join(domain_path) if domain_path else None
        _track_domain_perf(domain_str, "知識", _session_id, _turn_counter)
        # 查 domain_optimization 校正狀態
        domain_opt_kw = {}
        if domain_str:
            ddb = _db()
            drow = ddb.execute("SELECT * FROM domain_optimization WHERE path=?", (domain_str,)).fetchone()
            if drow and drow["corrections"] > 0:
                total = max(drow["total_hits"], 1)
                corr_rate = drow["corrections"] / total
                domain_opt_kw = {
                    "path": drow["path"],
                    "corrections": drow["corrections"],
                    "total_hits": drow["total_hits"],
                    "effective_hits": drow["effective_hits"],
                    "correction_rate": round(corr_rate, 2),
                    "deprecated": bool(drow["deprecated"]),
                }
            ddb.close()
        _self_audit(domain_str, "知識")
        # 元認知：knowledge path 的 confidence 評估
        knowledge_conf = _assess_confidence(domain_str, "知識", domain_opt_kw, [])
        return {"winner": "知識", "score": 0.3, "context": ctx, "runners_up": [],
                "object_id": None, "ontology": cl, "knowledge": knowledge["paths"] if knowledge else None,
                "domain_path": domain_path if domain_path else None,
                "domain_optimization": domain_opt_kw,
                "confidence": knowledge_conf}

    scored.sort(key=lambda x: -x[1])
    winner, winner_score = scored[0]
    for t, s in scored:
        t._winless_streak = 0 if t is winner else t._winless_streak + 1

    for t, s in scored:
        delta = 0.0
        if t is winner:
            t.base_weight = min(1.5, t.base_weight + 0.02); delta = +0.02
        else:
            t.base_weight = max(0.1, t.base_weight * 0.998)
            delta = (t.base_weight / 0.998) - t.base_weight if t.base_weight > 0.1 else 0
        if t.name not in _session_deltas: _session_deltas[t.name] = [0, 0, 0.0]
        _session_deltas[t.name][0] += 1
        if t is winner: _session_deltas[t.name][1] += 1
        _session_deltas[t.name][2] += round(delta, 4)

    runners = [{"name": t.name, "score": s, "gist": t.gist_text} for t, s in scored[1:]]
    context = winner.context_text
    if domain_enrichment:
        context = f"【領域視角】{domain_enrichment}\n\n{context}"
    if psi_signal:
        context = f"{psi_signal}\n\n{context}"
    if knowledge:
        ctx_lines = [f"📄 {p.replace('/Users/ryan', '~')}" for p in knowledge["paths"][:2]]
        context += "\n\n【參考資料】\n" + "\n".join(ctx_lines) + "\n\n" + knowledge["content"][:1000]
    if facets:
        context += "\n物件歷史:\n" + "\n".join(f"  [{f['tulpa_name']}] {f['view']} (×{f['count']})" for f in facets[:3])
    if runners:
        runner_str = " | ".join(f'[{r["name"]}: {r["gist"]}]' for r in runners)
        context += f"\n(背景: {runner_str})"
    if object_id: save_object_facet(object_id, winner.name, winner.context_text)
    if domain_path:
        d_oid = cl.get("object_id")
        if d_oid: save_object_facet(d_oid, winner.name, domain_path[-1])
    learn_ontology(text, winner.name)
    domain_str = "/".join(domain_path) if domain_path else None
    _track_domain_perf(domain_str, winner.name, _session_id, _turn_counter)
    _log_migration(winner.name)  # 記錄 weight 遷移

    # 查 domain_optimization 校正狀態
    domain_opt = {}
    if domain_str:
        db = _db()
        row = db.execute("SELECT * FROM domain_optimization WHERE path=?", (domain_str,)).fetchone()
        if row and row["corrections"] > 0:
            total = max(row["total_hits"], 1)
            corr_rate = row["corrections"] / total
            domain_opt = {
                "path": row["path"],
                "corrections": row["corrections"],
                "total_hits": row["total_hits"],
                "effective_hits": row["effective_hits"],
                "correction_rate": round(corr_rate, 2),
                "deprecated": bool(row["deprecated"]),
            }
        db.close()

    _self_audit(domain_str, winner.name)

    # 元認知：confidence 評估
    confidence = _assess_confidence(domain_str, winner.name, domain_opt, scored)

    # 對賭驗證：每輪 compete 結束後記錄 claim
    try:
        _record_claim(f"compete_{domain_str}_{_turn_counter}")
    except Exception as e:
        _log(f"對賭驗證記錄失敗: {e}")

    # Observer 第三位置
    try:
        _observe_third_position(winner, runners, domain_str)
    except Exception as e:
        _log(f"Observer 記錄失敗: {e}")

    # 持久化調整後的 weight
    save_tulpa_state(TULPAS)

    return {"winner": winner.name, "score": winner_score, "context": context,
            "runners_up": runners, "object_id": object_id, "ontology": cl,
            "knowledge": knowledge["paths"] if knowledge else None,
            "knowledge_found": knowledge is not None,
            "domain_path": domain_path if domain_path else None,
            "domain_optimization": domain_opt,
            "confidence": confidence}


